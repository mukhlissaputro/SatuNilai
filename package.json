{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build",
    "build": "vinext build",
    "start": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js start --hostname 0.0.0.0",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node scripts/generate-migrations.mjs",
    "docker:setup": "node scripts/docker-setup.mjs",
    "test:docker": "node --env-file=.env --test tests/docker-integration.test.mjs",
    "typecheck": "tsc --noEmit",
    "docker:backup": "node scripts/backup.mjs",
    "db:import:legacy": "node scripts/migrate-legacy.mjs",
    "dev:docker": "docker compose -f compose.yaml -f compose.dev.yaml up -d --build --wait",
    "test:unit": "node --test tests/legacy-export.test.mjs tests/sql-identifiers.test.mjs",
    "test:scoring": "node --experimental-strip-types --test tests/assessment-scoring.test.mjs tests/score-interpretation.test.mjs",
    "test:scoring:integration": "npm run build && node --env-file=.env scripts/test-flexible-scoring.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "mysql2": "^3.24.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
